# PRADAS Environment Configuration
# Copy this file to .env and adjust values as needed.

# Device: auto, cpu, or cuda
PRADAS_DEVICE=auto

# YOLO pose model (will be downloaded on first use)
PRADAS_YOLO_POSE_MODEL=yolov8n-pose.pt

# MiDaS model type
PRADAS_MIDAS_MODEL_TYPE=MiDaS_small

# Detection confidence threshold
PRADAS_CONFIDENCE_THRESHOLD=0.5

# Video source (file path, camera index, or RTSP URL)
PRADAS_VIDEO_SOURCE=0

# Output video path (empty = no recording)
PRADAS_OUTPUT_VIDEO=

# API settings
PRADAS_API_HOST=0.0.0.0
PRADAS_API_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
PRADAS_LOG_LEVEL=INFO

# Night enhancement: auto, always, never
PRADAS_NIGHT_MODE=auto

# Frame skip (process every Nth frame, 1 = no skip)
PRADAS_FRAME_SKIP=1

# WebSocket enabled
PRADAS_WS_ENABLED=false
